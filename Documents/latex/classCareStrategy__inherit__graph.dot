  Node1 [id="Node000001",label="CareStrategy",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Defines the interface for different plant care strategies."];
  Node1 -> Node2 [id="edge4_Node000001_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="FertilizerBoostStrategy",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classFertilizerBoostStrategy.html",tooltip="Represents a care strategy that enhances plant growth through application of fertilizer."];
  Node1 -> Node3 [id="edge5_Node000001_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="RegularCareStrategy",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classRegularCareStrategy.html",tooltip="Represents a standard care strategy that provides consistent maintenance to plants."];
  Node1 -> Node4 [id="edge6_Node000001_Node000004",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node4 [id="Node000004",label="WaterLimitingStrategy",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classWaterLimitingStrategy.html",tooltip="Represents a care strategy that limits water intake to strengthen the plant."];
}
