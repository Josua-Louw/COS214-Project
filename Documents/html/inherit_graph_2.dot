  rankdir="LR";
  Node0 [id="Node000000",label="CareStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classCareStrategy.html",tooltip="Defines the interface for different plant care strategies."];
  Node0 -> Node1 [id="edge28_Node000000_Node000001",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node1 [id="Node000001",label="FertilizerBoostStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classFertilizerBoostStrategy.html",tooltip="Represents a care strategy that enhances plant growth through application of fertilizer."];
  Node0 -> Node2 [id="edge29_Node000000_Node000002",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node2 [id="Node000002",label="RegularCareStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classRegularCareStrategy.html",tooltip="Represents a standard care strategy that provides consistent maintenance to plants."];
  Node0 -> Node3 [id="edge30_Node000000_Node000003",dir="back",color="steelblue1",style="solid",tooltip=" "];
  Node3 [id="Node000003",label="WaterLimitingStrategy",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$classWaterLimitingStrategy.html",tooltip="Represents a care strategy that limits water intake to strengthen the plant."];
}
